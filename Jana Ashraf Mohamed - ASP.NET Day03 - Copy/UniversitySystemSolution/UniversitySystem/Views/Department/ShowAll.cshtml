@model List<Department>

<h2>All Departments</h2>

<table border="1">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Manager</th>
        <th>Details</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.MgrName</td>
            <td>
                <a href="/Department/ShowDetails/@item.Id">Details</a>
            </td>
        </tr>
    }

</table>
